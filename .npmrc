# npm (v10.9.3 at the time this was added) crashes with
# "Cannot read properties of null (reading 'edgesOut')" while resolving
# vitest's optional peer dependency @vitest/browser-playwright, regardless of
# which vitest version is requested -- a reproducible npm/@npmcli/arborist bug,
# not anything specific to this project's dependency versions. legacy-peer-deps
# sidesteps the crash by using npm's older, less strict peer-resolution
# algorithm. Safe here: this project has no conflicting peer dependency
# requirements that need the strict resolver's enforcement.
legacy-peer-deps=true
