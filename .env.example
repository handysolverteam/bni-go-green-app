# Cross-app SSO (separate domains, bridged via a redirect + one-time code exchange -- see
# src/lib/sso.ts). Comma-separated list of every OTHER trusted app sharing this Firebase
# project; add more here as they're built. bni-rrc needs its own list including
# https://www.handychapter.com.
VITE_SSO_PARTNER_URLS=https://bni-rrc.vercel.app

# The sso-issue / sso-consume Supabase Edge Functions also need these set as Supabase
# secrets (NOT in this file -- they must never reach the browser):
#   supabase secrets set FIREBASE_PROJECT_ID=... FIREBASE_DATABASE_URL=... \
#     FIREBASE_ADMIN_CLIENT_EMAIL=... FIREBASE_ADMIN_PRIVATE_KEY=...
# Values come from the same Firebase service-account JSON used by bni-rrc's
# FIREBASE_ADMIN_CLIENT_EMAIL / FIREBASE_ADMIN_PRIVATE_KEY.
